<PageLayout @showCategories={{true}} @showHeaderSearch={{false}}>
  <LargeSearch @onQueryChange={{fn (mut this.query)}} @onSearchReadmesChange={{fn (mut this.searchReadmes)}} @query={{this.query}} @searchReadmes={{this.searchReadmes}} />
  <RouteIndex class="route-index" @topAddons={{this.model.topAddons}} @newAddons={{this.model.newAddons}} @recentlyScoredAddons={{this.model.recentlyScoredAddons}} />
</PageLayout>
