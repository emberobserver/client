    "@rollup/plugin-babel": "^7.1.0",
    "@warp-drive/core": "~5.8.2",
    "babel-eslint": "^10.1.0",
    "babel-plugin-debug-macros": "^2.0.1",
    "babel-plugin-ember-template-compilation": "^4.0.2",
    "bourbon": "4.2.3",
    "bourbon-neat": "1.7.1",
    "concurrently": "^9.2.5",
    "decorator-transforms": "^2.4.0",
    "dompurify": "^2.5.9",
    "ember-basic-dropdown": "^9.1.0",
    "ember-cli-deprecation-workflow": "^4.0.1",
    "ember-cli-showdown": "^10.0.0",
    "ember-concurrency": "^5.3.0",
    "ember-data": "~5.8.2",
    "ember-decorators": "^7.0.0",
    "ember-eslint": "^1.1.0",
    "ember-inflector": "^7.0.2",
