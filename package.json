    "ember-modifier": "^4.3.0",
    "ember-moment": "^11.1.0",
    "ember-page-title": "^9.1.0",
    "ember-power-select": "^9.0.6",
    "ember-qunit": "^9.2.1",
    "ember-source": "~7.4.1",
    "ember-template-lint": "^7.9.4",
    "eslint": "^10.15.0",
    "faker": "^4.1.0",
    "glob": "^7.2.3",
    "http-proxy": "^1.18.1",
    "jquery": "^3.8.0",
    "miragejs": "^0.1.48",
    "moment": "^2.31.0",
    "moment-timezone": "^0.5.48",
    "morgan": "^1.12.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.10.1",
