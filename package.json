  "engines": {
    "node": "10.* || >= 12"
  },
  "ember": {
    "edition": "octane"
  },
  "packageManager": "pnpm@12.23.0",
  "imports": {
    "#app/*": "./app/*",
    "#config": "./app/config.js",
    "#components/*": "./app/components/*",
    "#services/*": "./app/services/*",
    "#test-helpers/*": "./tests/helpers/*",
    "#utils/*": "./app/utils/*",
    "#mirage/*": "./mirage/*"
  },
  "exports": {
    "./tests/*": "./tests/*",
    "./*": "./app/*"
  },
  "dependencies": {
    "@embroider/router": "^3.0.6"
  },
  "type": "module"
}
